# FastAPI PostgreSQL Boilerplate - Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Async PostgreSQL connection (primary)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fastapi_db

# Sync PostgreSQL connection (for migrations and sync operations)
DATABASE_URL_WITHOUT_ASYNC=postgresql://postgres:password@localhost:5432/fastapi_db

# Database connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Application metadata
PROJECT_NAME=FastAPI PostgreSQL Boilerplate
VERSION=1.0.0
DESCRIPTION=Enterprise-grade FastAPI boilerplate with PostgreSQL
API_V1_STR=/api/v1

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE=logs/app.log

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET_TOKEN=your-super-secret-jwt-key-change-in-production-must-be-32-chars-minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# CORS settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["*"]

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
SMTP_SSL=false

# Email settings
EMAIL_FROM=noreply@yourapp.com
EMAIL_FROM_NAME=Your App Name
EMAIL_TEMPLATES_DIR=app/templates/email

# AWS SES (Alternative to SMTP)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# =============================================================================
# AWS CONFIGURATION (Optional)
# =============================================================================
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_S3_ENDPOINT_URL=
AWS_S3_USE_SSL=true

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=["image/jpeg", "image/png", "image/gif", "application/pdf"]

# =============================================================================
# MONITORING & OBSERVABILITY
# =============================================================================
# Prometheus metrics
PROMETHEUS_ENABLED=true
METRICS_ENABLED=true
METRICS_PORT=9090

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30

# Error tracking (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# =============================================================================
# BACKGROUND TASKS (Procrastinate)
# =============================================================================
# Procrastinate worker configuration
PROCRASTINATE_WORKER_CONCURRENCY=4
PROCRASTINATE_WORKER_TIMEOUT=300
PROCRASTINATE_QUEUE_NAME=default

# Task queue settings
TASK_QUEUE_ENABLED=true
TASK_QUEUE_MAX_WORKERS=8
TASK_QUEUE_TIMEOUT=300

# =============================================================================
# PLUGIN SYSTEM
# =============================================================================
# Plugin configuration
PLUGINS_ENABLED=true
PLUGINS_DIR=app/plugins
PLUGIN_AUTO_DISCOVERY=true

# Individual plugin toggles (set to false to disable)
PLUGIN_MONITORING_ENABLED=true
PLUGIN_CACHE_ENABLED=true
PLUGIN_AUTH_ENHANCED_ENABLED=true
PLUGIN_BOOK_PLUGIN_ENABLED=true
PLUGIN_CUSTOMER_PLUGIN_ENABLED=true
PLUGIN_PRODUCT_PLUGIN_ENABLED=true
PLUGIN_ORDER_PLUGIN_ENABLED=true

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Cache settings
CACHE_ENABLED=true
CACHE_TTL=3600  # 1 hour
CACHE_PREFIX=fastapi_app
CACHE_BACKEND=redis

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=1000

# =============================================================================
# PRODUCTION SETTINGS
# =============================================================================
# Gunicorn configuration
GUNICORN_WORKERS=4
GUNICORN_WORKER_CLASS=uvicorn.workers.UvicornWorker
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=60
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=50

# SSL/TLS (for production)
SSL_KEYFILE=
SSL_CERTFILE=
SSL_CA_CERTS=
SSL_VERIFY_MODE=

# Security headers
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development tools
HOT_RELOAD=true
AUTO_RELOAD=true
RELOAD_DIRS=["app"]

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/fastapi_test_db
TEST_REDIS_URL=redis://localhost:6379/1

# Debug settings
DEBUG_SQL=false
DEBUG_REDIS=false
DEBUG_PLUGINS=false

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Stripe (for payments)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Feature toggles
FEATURE_USER_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PASSWORD_RESET=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_SOCIAL_LOGIN=false
FEATURE_API_VERSIONING=true
FEATURE_RATE_LIMITING=true
FEATURE_AUDIT_LOGGING=true

# =============================================================================
# LOCALIZATION
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=["en", "es", "fr", "de"]
TIMEZONE=UTC

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Connection timeouts
HTTP_TIMEOUT=30
DATABASE_TIMEOUT=30
REDIS_TIMEOUT=5

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# =============================================================================
# CUSTOM APPLICATION SETTINGS
# =============================================================================
# Add your custom environment variables here
# CUSTOM_SETTING_1=value1
# CUSTOM_SETTING_2=value2 